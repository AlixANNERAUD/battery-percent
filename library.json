{
  "name": "battery-percent",
  "version": "2.0.0",
  "description": "Hardware-agnostic battery state-of-charge estimation from cell voltage. Plain C99, no dependencies, built-in LiPo, Li-ion, LiFePO4, NiMH and alkaline curves.",
  "keywords": "battery, lipo, li-ion, lifepo4, state of charge, fuel gauge",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlixANNERAUD/Battery-Percent.git"
  },
  "authors": [
    {
      "name": "Alix ANNERAUD",
      "email": "alix@anneraud.fr",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "headers": "battery_percent.h",
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "srcFilter": ["+<battery_percent.c>"]
  },
  "export": {
    "include": [
      "include/battery_percent.h",
      "src/battery_percent.c",
      "library.json",
      "README.md",
      "LICENSE",
      "Changelog.md"
    ]
  }
}
