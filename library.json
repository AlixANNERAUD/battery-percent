{
  "name": "battery-percent",
  "version": "2.0.0",
  "description": "Hardware-agnostic battery state-of-charge estimation from cell voltage. Plain C99, no dependencies, sourced LiPo, Li-ion, LiFePO4, NiMH and alkaline curves.",
  "keywords": "battery, lipo, li-ion, lifepo4, state of charge, fuel gauge, embedded",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlixANNERAUD/battery-percent.git"
  },
  "homepage": "https://github.com/AlixANNERAUD/battery-percent",
  "authors": [
    {
      "name": "Alix ANNERAUD",
      "email": "alix@anneraud.fr",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "headers": "battery_percent.h",
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "srcFilter": ["+<*.c>"]
  },
  "export": {
    "exclude": [
      "tests",
      "examples",
      "src/lib.rs",
      "build.rs",
      "Cargo.toml",
      "Cargo.lock",
      "release-plz.toml",
      "RELEASING.md",
      "scripts",
      "target",
      "build*",
      ".github",
      ".claude"
    ]
  },
  "frameworks": "*",
  "platforms": "*"
}
